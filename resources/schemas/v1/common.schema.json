{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Research Provenance v1 common definitions",
  "$comment": "Compartment ordering, path containment, reference resolution, and access closure are semantic Core checks.",
  "type": "object",
  "$defs": {
    "ids": {
      "type": "object",
      "$defs": {
        "project": {
          "type": "string",
          "pattern": "^proj_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "run": {
          "type": "string",
          "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "event": {
          "type": "string",
          "pattern": "^ev_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "node": {
          "type": "string",
          "pattern": "^(?:dset|qst|hyp|obs|meas|mth|tst|pred|syn|int|dec|con|blk|nxt|clm|node)_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "dataset": {
          "type": "string",
          "pattern": "^dset_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "question": {
          "type": "string",
          "pattern": "^qst_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "hypothesis": {
          "type": "string",
          "pattern": "^hyp_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "observation": {
          "type": "string",
          "pattern": "^obs_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "measurement": {
          "type": "string",
          "pattern": "^meas_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "method": {
          "type": "string",
          "pattern": "^mth_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "test": {
          "type": "string",
          "pattern": "^tst_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "prediction": {
          "type": "string",
          "pattern": "^pred_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "synthesis": {
          "type": "string",
          "pattern": "^syn_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "interpretation": {
          "type": "string",
          "pattern": "^int_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "decision": {
          "type": "string",
          "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "conclusion": {
          "type": "string",
          "pattern": "^con_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "blocker": {
          "type": "string",
          "pattern": "^blk_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "next_action": {
          "type": "string",
          "pattern": "^nxt_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "paper_claim": {
          "type": "string",
          "pattern": "^clm_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "extension_node": {
          "type": "string",
          "pattern": "^node_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "relation": {
          "type": "string",
          "pattern": "^rel_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "assessment": {
          "type": "string",
          "pattern": "^asm_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "thread": {
          "type": "string",
          "pattern": "^thd_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "binding": {
          "type": "string",
          "pattern": "^tbd_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "claim_chain": {
          "type": "string",
          "pattern": "^cch_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "reference": {
          "type": "string",
          "pattern": "^ref_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "artifact": {
          "type": "string",
          "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "model": {
          "type": "string",
          "pattern": "^model_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "agent",
            "software",
            "service",
            "host",
            "model"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "compartments"
      ],
      "properties": {
        "level": {
          "enum": [
            "public",
            "internal",
            "restricted",
            "exclusive"
          ]
        },
        "compartments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:dset|qst|hyp|obs|meas|mth|tst|pred|syn|int|dec|con|blk|nxt|clm|node)_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "relations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^rel_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "external_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ref_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "events": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ev_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9.-]*/v[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_from": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "observed_to": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "effective_until": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "review_due_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.research/notes/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s]+\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "node_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parents",
        "summary"
      ],
      "properties": {
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(?:dset|qst|hyp|obs|meas|mth|tst|pred|syn|int|dec|con|blk|nxt|clm|node)_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "change_type": {
                "enum": [
                  "clarification",
                  "scope_refinement",
                  "scope_expansion",
                  "assumption_change",
                  "method_optimization",
                  "parameter_change",
                  "evidence_incorporation",
                  "error_correction",
                  "branch_reconciliation",
                  "conceptual_replacement"
                ]
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relation_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parents",
        "summary"
      ],
      "properties": {
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^rel_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "change_type": {
                "enum": [
                  "clarification",
                  "scope_refinement",
                  "scope_expansion",
                  "assumption_change",
                  "method_optimization",
                  "parameter_change",
                  "evidence_incorporation",
                  "error_correction",
                  "branch_reconciliation",
                  "conceptual_replacement"
                ]
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "binding_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parents",
        "summary"
      ],
      "properties": {
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^tbd_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "change_type": {
                "enum": [
                  "clarification",
                  "scope_refinement",
                  "scope_expansion",
                  "assumption_change",
                  "method_optimization",
                  "parameter_change",
                  "evidence_incorporation",
                  "error_correction",
                  "branch_reconciliation",
                  "conceptual_replacement"
                ]
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
