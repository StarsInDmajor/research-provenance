{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment.schema.json",
  "title": "rp/assessment/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "target",
    "assessment_scope",
    "epistemic_status",
    "evidence_evaluation",
    "quantitative_assessment",
    "assessed_at",
    "assessed_by",
    "source",
    "supersedes_assessments",
    "review_assurance",
    "access"
  ],
  "properties": {
    "schema": {
      "const": "rp/assessment/v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/ids/$defs/assessment"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "node_revision"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/ids/$defs/node"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "relation_revision"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/ids/$defs/relation"
            }
          }
        }
      ]
    },
    "assessment_scope": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_status": {
      "enum": [
        "proposed",
        "active_testing",
        "supported",
        "challenged",
        "inconclusive",
        "refuted"
      ]
    },
    "evidence_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_quality",
        "agreement",
        "independence",
        "directness",
        "decision_confidence",
        "rationale",
        "limitations"
      ],
      "properties": {
        "evidence_quality": {
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ]
        },
        "agreement": {
          "enum": [
            "unknown",
            "isolated",
            "consistent",
            "mixed",
            "conflicting"
          ]
        },
        "independence": {
          "enum": [
            "unknown",
            "same_run",
            "shared_data",
            "shared_pipeline",
            "partially_independent",
            "independent"
          ]
        },
        "directness": {
          "enum": [
            "unknown",
            "direct",
            "indirect",
            "proxy",
            "model_extrapolation"
          ]
        },
        "decision_confidence": {
          "enum": [
            "unknown",
            "low",
            "medium",
            "high",
            "blocked"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      }
    },
    "quantitative_assessment": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "value",
            "unit",
            "method",
            "source_measurements"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "pattern": "^[+-]?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "model_version": {
              "$ref": "common.schema.json#/$defs/ids/$defs/model"
            },
            "source_measurements": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/ids/$defs/measurement"
              }
            }
          }
        }
      ]
    },
    "assessed_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "assessed_by": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "supersedes_assessments": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/ids/$defs/assessment"
      }
    },
    "review_assurance": {
      "enum": [
        "unreviewed",
        "machine-validated",
        "policy-validated",
        "human-reviewed"
      ]
    },
    "access": {
      "$ref": "common.schema.json#/$defs/access"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
